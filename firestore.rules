rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
    }
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /authorized_users/{document=**} {
      allow write: if request.auth != null;
    }
    
    match /app_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authorized users to write to global collections
    match /agmp_tahun_ajaran/{document=**} { allow write: if request.auth != null; }
    match /agmp_kelas/{document=**} { allow write: if request.auth != null; }
    match /agmp_siswa/{document=**} { allow write: if request.auth != null; }
    match /agmp_mapel/{document=**} { allow write: if request.auth != null; }
    match /agmp_dimensi/{document=**} { allow write: if request.auth != null; }
    match /agmp_tema_kokurikuler/{document=**} { allow write: if request.auth != null; }
    match /agmp_kegiatan_kokurikuler/{document=**} { allow write: if request.auth != null; }
    match /agmp_asesmen_formatif_koku/{document=**} { allow write: if request.auth != null; }
    match /agmp_asesmen_sumatif_koku/{document=**} { allow write: if request.auth != null; }
    match /agmp_rubrik_kokurikuler/{document=**} { allow write: if request.auth != null; }
    match /agmp_absensi_kokurikuler/{document=**} { allow write: if request.auth != null; }
    match /agmp_fasilitator/{document=**} { allow write: if request.auth != null; }
  }
}
